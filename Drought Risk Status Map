def vhi_download_file(url, save_path):
    if os.path.exists(save_path):
        print(f'  Already exists, skipping: {os.path.basename(save_path)}')
        return
    response = requests.get(url, stream=True)
    if response.status_code == 200:
        with open(save_path, 'wb') as f:
            for chunk in response.iter_content(chunk_size=8192):
                f.write(chunk)
        print(f'  Downloaded: {os.path.basename(save_path)}')
    else:
        print(f'  FAILED (status {response.status_code}): {url}')

def vhi_get_nc_links(year_url, file_filter):
    response = requests.get(year_url)
    soup = BeautifulSoup(response.text, 'html.parser')
    return [
        year_url.rstrip('/') + '/' + a['href']
        for a in soup.find_all('a', href=True)
        if a['href'].endswith('.nc') and file_filter in a['href']
    ]

