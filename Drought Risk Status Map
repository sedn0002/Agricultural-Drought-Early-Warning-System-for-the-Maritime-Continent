import matplotlib.patheffects as pe

def add_scale_bar(ax, length_km=500, label='500 km', x0_frac=0.05, y0_frac=0.05, ref_lat=-6.0):
    """Add a scale bar to a cartopy map axis."""
    # Convert km to degrees longitude at the reference latitude
    km_per_deg_lon = 111.32 * np.cos(np.radians(ref_lat))
    length_deg     = length_km / km_per_deg_lon

    # Get axis extent in data coordinates
    x0_data, x1_data, y0_data, y1_data = ax.get_extent(ccrs.PlateCarree())
    x_range = x1_data - x0_data
    y_range = y1_data - y0_data

    # Position of scale bar start
    x0 = x0_data + x0_frac * x_range
    y0 = y0_data + y0_frac * y_range

    # Draw the scale bar line
    ax.plot(
        [x0, x0 + length_deg], [y0, y0],
        color='black', linewidth=2.5,
        transform=ccrs.PlateCarree(), zorder=10
    )
    # End ticks
    tick_h = y_range * 0.008
    for x in [x0, x0 + length_deg]:
        ax.plot(
            [x, x], [y0 - tick_h, y0 + tick_h],
            color='black', linewidth=2.5,
            transform=ccrs.PlateCarree(), zorder=10
        )
    # Label
    ax.text(
        x0 + length_deg / 2, y0 + y_range * 0.018,
        label,
        ha='center', va='bottom', fontsize=9,
        transform=ccrs.PlateCarree(), zorder=10,
        path_effects=[pe.withStroke(linewidth=2, foreground='white')]
    )

