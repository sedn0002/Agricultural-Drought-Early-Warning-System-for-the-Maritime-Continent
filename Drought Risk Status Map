def transform_probability(hc_file, fc_file, out_prefix, label):
    """Calculate Probability of Above-Median (PAM) from hindcast and forecast GRIB files."""
    print(f'\nProcessing {label}...')

    for path, name in [(hc_file, 'Hindcast'), (fc_file, 'Forecast')]:
        if not os.path.exists(path):
            print(f'{name} file missing, skipping: {path}')
            return None

    ds_hc = xr.open_dataset(hc_file, engine='cfgrib')
    ds_fc = xr.open_dataset(fc_file, engine='cfgrib')
    tp_var = list(ds_hc.data_vars)[0]

    hc_median = ds_hc[tp_var].median(dim=['time', 'number'])
    fc_da     = ds_fc[tp_var]

    # Restore 'step' as a real dimension if collapsed to scalar
    if 'step' not in fc_da.dims:
        fc_da = fc_da.expand_dims('step')
    if 'step' not in hc_median.dims:
        hc_median = hc_median.expand_dims('step')

    common_steps = np.intersect1d(fc_da.step.values, hc_median.step.values)
    fc_aligned   = fc_da.sel(step=common_steps)
    hc_aligned   = hc_median.sel(step=common_steps)

    prob_above_median = (
        (fc_aligned > hc_aligned)
        .mean(dim=[d for d in fc_aligned.dims if d not in ['step', 'latitude', 'longitude']])
        * 100
    )
    prob_plot = prob_above_median.mean(dim='step').clip(min=0, max=100)

    prob_file = PAM_SAVE_DIR + f'/prob_above_median_{out_prefix}.nc'
    # Remove existing file to avoid permission errors on re-run
    if os.path.exists(prob_file):
        os.remove(prob_file)
    prob_above_median.to_netcdf(prob_file)
    print(f'Saved probability: {prob_file}')

    prob_plot_file = PAM_SAVE_DIR + f'/prob_plot_{out_prefix}.nc'
    if os.path.exists(prob_plot_file):
        os.remove(prob_plot_file)
    prob_plot.to_netcdf(prob_plot_file)
    print(f'Saved prob plot: {prob_plot_file}')

    return prob_plot_file

